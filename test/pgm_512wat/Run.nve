#!/bin/sh
#TEST-PROGRAM sander
#TEST-DESCRIP TO_BE_DEtermined
#TEST-PURPOSE regression, basic
#TEST-STATE   undocumented

if [ -z "$TESTsander" ]; then
   TESTsander="${AMBERHOME}/bin/sander"
fi

if [ -z "$DO_PARALLEL" ]; then
   DO_PARALLEL=" "
fi

cat > mdin <<EOF
  single point calc.
 &cntrl
   imin=0, nstlim=10,
   irest=1, ntx=5,
   ntb=1, ntp=0,
   ntt=0, temp0=300
   ntc=2, ntf=2, tol=0.0000001, 
   cut=9., 
   ntpr=1, ntwr=1000, ntwx=1000,
   dt=0.001,
   ipgm=1,
 /
 &ewald
  skinnb=2.,ew_coeff=0.4,nfft1=50,nfft2=50,nfft3=50,order=8,vdwmeth=0
 /
 &pol_gauss
   pol_gauss_verbose=0,ee_dsum_cut=9.0,
   dipole_scf_tol=0.001,dipole_scf_init=1,dipole_scf_init_order=1,dipole_scf_init_step=2,
   scf_solv_opt=1,scf_sor_niter=100,scf_sor_coefficient=0.65,
   scf_cg_niter=50,scf_local_niter=3,scf_local_cut=4.0
 /
EOF

output="nve.out"
$DO_PARALLEL $TESTsander -O -i mdin -c restrt0 -o $output < /dev/null \
        || { echo "  ${0}:  Program error"; exit 1; }

../dacdif -f -a 1e-2 $output.save $output
/bin/rm -f mdin restrt mdcrd mdinfo logfile
exit 0
